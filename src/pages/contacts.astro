---
import Base from '../layouts/Base.astro';
import CopyEmail from '../components/CopyEmail.astro';
import { person, telegramUrl, url } from '../data/site';

const links = [
  { label: 'Telegram', value: `@${person.telegram}`, href: telegramUrl, external: true },
  { label: 'Резюме', value: 'Смотреть резюме', href: url('/resume') },
];
const rowValue = 'text-[clamp(1.4rem,3.6vw,3rem)] font-light tracking-tight';
---

<Base title="Контакты" description="Мария Молодцова открыта к предложениям о работе. Telegram, почта, резюме.">
  <section class="px-5 pb-24 pt-32 md:px-10 md:pt-44">
    <h1 class="display max-w-[16ch] text-[min(clamp(2.6rem,7vw,6.5rem),9.4vw)]" data-reveal>Открыта<br />к&nbsp;предложениям о&nbsp;<em>работе</em></h1>

    <ul class="mt-16 border-t border-line md:mt-24">
      {
        links.map((l, i) => (
          <li class="border-b border-line" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
            <a
              href={l.href}
              target={l.external ? '_blank' : undefined}
              rel={l.external ? 'noopener' : undefined}
              class="group flex flex-col gap-2 py-8 md:flex-row md:items-baseline md:justify-between"
            >
              <span class="eyebrow">{l.label}</span>
              <span class:list={[rowValue, 'transition-colors group-hover:text-accent']}>
                {l.value} <span class="inline-block transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </span>
            </a>
          </li>
        ))
      }
      <li class="flex flex-col gap-2 border-b border-line py-8 md:flex-row md:items-baseline md:justify-between" data-reveal style="--reveal-delay: 160ms">
        <span class="eyebrow">Почта</span>
        <CopyEmail class={rowValue} />
      </li>
    </ul>
  </section>
</Base>
