---
import Base from '../layouts/Base.astro';
import { person, telegramUrl, url } from '../data/site';

const links = [
  { label: 'Telegram', value: `@${person.telegram}`, href: telegramUrl, external: true },
  { label: 'Резюме', value: 'Смотреть резюме', href: url('/resume') },
  { label: 'Behance', value: 'Архив ранних работ', href: person.behance, external: true },
];
const rowValue = 'text-[clamp(1.4rem,3.6vw,3rem)] font-light tracking-tight transition-colors group-hover:text-accent';
---

<Base title="Контакты" description="Как связаться с Марией Молодцовой: Telegram, резюме и почта.">
  <section class="px-5 pb-24 pt-32 md:px-10 md:pt-44">
    <h1 class="display max-w-[14ch] text-[clamp(2.6rem,7vw,6.5rem)]" data-reveal>Давайте <em>поговорим</em></h1>
    <p class="mt-6 max-w-xl text-lg text-muted" data-reveal>
      Открыта к предложениям о работе в продуктовых командах, удалённо или в гибридном формате. Быстрее всего отвечаю в Telegram.
    </p>

    <ul class="mt-16 border-t border-line md:mt-24">
      {
        links.map((l, i) => (
          <li class="border-b border-line" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
            <a
              href={l.href}
              target={l.external ? '_blank' : undefined}
              rel={l.external ? 'noopener' : undefined}
              class="group flex flex-col gap-2 py-8 md:flex-row md:items-baseline md:justify-between"
            >
              <span class="eyebrow">{l.label}</span>
              <span class={rowValue}>
                {l.value} <span class="inline-block transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </span>
            </a>
          </li>
        ))
      }
      <li class="border-b border-line" data-reveal style="--reveal-delay: 240ms">
        <button
          type="button"
          class="group flex w-full flex-col gap-2 py-8 text-left md:flex-row md:items-baseline md:justify-between"
          data-copy={person.email}
        >
          <span class="eyebrow">Почта · нажмите, чтобы скопировать</span>
          <span class:list={[rowValue, 'break-all text-[clamp(1.1rem,2.4vw,2rem)]']}>{person.email}</span>
        </button>
      </li>
    </ul>
  </section>
</Base>
