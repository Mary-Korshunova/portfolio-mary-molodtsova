---
import Base from '../layouts/Base.astro';
import ContactCta from '../components/ContactCta.astro';
import { url } from '../data/site';

const photos = Array.from({ length: 33 }, (_, i) => {
  const n = String(i + 1).padStart(2, '0');
  const ext = 'webp';
  return { src: `/assets/about/${n}.${ext}`, alt: `Фотография из путешествий и повседневной жизни, кадр ${i + 1}` };
});
---

<Base title="Обо мне" description="Путешествия, фотография, горы и уютные домашние увлечения Марии Молодцовой.">
  <section class="px-5 pt-32 md:px-10 md:pt-44">
    <h1 class="display max-w-[16ch] text-[clamp(2.6rem,7vw,6.5rem)]" data-reveal>Немного <em>обо мне</em></h1>
    <p class="mt-12 max-w-none text-lg leading-relaxed text-fg/85 md:mt-16 md:text-xl" data-reveal>
      Люблю путешествовать и фотографировать — ловить живые эмоции людей, животных и красоту природы. Особенно меня тянут горы: я несколько раз ходила в треккинг в Приэльбрусье и мечтаю однажды увидеть Кордильеры. Дома тоже хватает маленьких радостей: вяжу небольшие вещицы, забочусь о цветах, аквариумных рыбках и сомике Майке, а за птичками под окном могу наблюдать бесконечно.
    </p>
  </section>

  <section class="px-5 py-16 md:px-10 md:py-24">
    <div class="columns-2 gap-3 sm:gap-5 lg:columns-3 [&>*]:mb-3 [&>*]:break-inside-avoid sm:[&>*]:mb-5">
      {photos.map((photo, i) => (
        <figure class="mb-3 overflow-hidden rounded sm:mb-5" data-reveal style={`--reveal-delay: ${(i % 3) * 80}ms`}>
          <img src={url(photo.src)} alt={photo.alt} loading="lazy" decoding="async" class="block h-auto w-full rounded" />
        </figure>
      ))}
    </div>
  </section>
  <ContactCta />
</Base>
