---
import Base from '../layouts/Base.astro';
import ContactCta from '../components/ContactCta.astro';
import { url } from '../data/site';

const photos = Array.from({ length: 33 }, (_, i) => {
  const n = String(i + 1).padStart(2, '0');
  const ext = 'webp';
  return { src: `/assets/about/${n}.${ext}`, alt: `Фотография из путешествий и повседневной жизни, кадр ${i + 1}` };
}).filter((_, i) => ![4, 5, 12, 21, 22, 23].includes(i));
---

<Base title="Обо мне" description="Путешествия, фотография, горы и уютные домашние увлечения Марии Молодцовой.">
  <section class="px-5 pt-32 md:px-10 md:pt-44">
    <h1 class="display max-w-[16ch] text-[clamp(2.6rem,7vw,6.5rem)]" data-reveal>Немного <em>обо мне</em></h1>
    <p class="mt-12 max-w-none text-lg leading-relaxed text-fg/85 md:mt-16 md:text-xl" data-reveal>
      Люблю путешествовать и фотографировать красоту вокруг, архитектуру и природу. Дома меня ждут аквариумные рыбки и сомик Майк.
    </p>
  </section>

  <section class="px-5 pb-16 pt-8 md:px-10 md:pb-24 md:pt-12">
    <div class="columns-2 gap-3 select-none sm:columns-4 lg:columns-8" role="region" aria-label="Фотографии" data-photo-gallery>
      {photos.map((photo) => (
        <figure class="mb-3 break-inside-avoid">
          <img src={url(photo.src)} alt={photo.alt} loading="lazy" decoding="async" draggable="false" class="pointer-events-none block h-auto w-full rounded-[4px]" />
        </figure>
      ))}
    </div>
  </section>
  <ContactCta />
</Base>

<style>
  [data-photo-gallery] {
    -webkit-touch-callout: none;
  }
</style>

<script>
  const gallery = document.querySelector('[data-photo-gallery]');
  for (const eventName of ['contextmenu', 'dragstart', 'copy']) {
    gallery?.addEventListener(eventName, (event) => event.preventDefault());
  }
</script>
