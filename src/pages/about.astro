---
import Base from '../layouts/Base.astro';
import ContactCta from '../components/ContactCta.astro';
import Placeholder from '../components/Placeholder.astro';

// Черновик текста. Мария поправит.
const photos = [
  { caption: 'Треккинг в Приэльбрусье: горы, тропа, я с рюкзаком', ratio: '4 / 5' },
  { caption: 'Сомик Майк и рыбки в аквариуме', ratio: '1 / 1' },
  { caption: 'Мой кадр: эмоции человека крупным планом', ratio: '4 / 5' },
  { caption: 'Связанные мелочи: игрушки, носки, брелоки', ratio: '1 / 1' },
  { caption: 'Цветы на подоконнике и птички за окном', ratio: '4 / 5' },
  { caption: 'Мой кадр: животное или природа из путешествия', ratio: '1 / 1' },
];
---

<Base title="Обо мне" description="Чем живёт Мария Молодцова вне работы: горы, фотография, вязание и сомик Майк.">
  <section class="px-5 pt-32 md:px-10 md:pt-44">
    <h1 class="display max-w-[16ch] text-[clamp(2.6rem,7vw,6.5rem)]" data-reveal>Немного <em>обо мне</em></h1>

    <div class="mt-14 grid gap-12 md:mt-20 md:grid-cols-[1fr_1.4fr] md:gap-20">
      <p class="eyebrow" data-reveal>Москва · родом из Кирова</p>
      <div class="space-y-6 text-lg leading-relaxed text-fg/85 md:text-xl" data-reveal>
        <p>
          Привет! Я родом из Кирова, а сейчас живу в Москве. В работе я люблю порядок и логику, а вне её отдыхаю там, где
          их меньше всего: в горах, в дороге и с камерой в руках.
        </p>
        <p>
          Я очень люблю путешествовать и фотографировать. Больше всего мне нравится ловить эмоции: улыбку человека,
          любопытный взгляд животного, свет над холмами. Для меня живой кадр ценнее идеальной композиции.
        </p>
        <p>
          Горы — моё место силы. Я несколько раз ходила в треккинг в Приэльбрусье и каждый раз возвращалась с мыслью
          «хочу ещё». Большая мечта — увидеть Кордильеры вживую.
        </p>
        <p>
          Дома у меня тихо и уютно. Я вяжу, в основном небольшие вещицы, ухаживаю за цветами, а в аквариуме живут
          рыбки и сомик Майк, самый спокойный член нашей семьи. А под окном живут птички, и с ними любое утро начинается
          чуть радостнее.
        </p>
      </div>
    </div>
  </section>

  <section class="px-5 py-20 md:px-10 md:py-32">
    <div class="columns-1 gap-6 sm:columns-2 lg:columns-3 [&>*]:mb-6 [&>*]:break-inside-avoid">
      {
        photos.map((p, i) => (
          <div data-reveal style={`--reveal-delay: ${(i % 3) * 100}ms`}>
            <Placeholder caption={p.caption} ratio={p.ratio} />
          </div>
        ))
      }
    </div>
  </section>

  <ContactCta />
</Base>
