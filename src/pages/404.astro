---
import Base from '../layouts/Base.astro';
import { url } from '../data/site';
---

<Base title="Страница не найдена">
  <section class="flex min-h-[80dvh] flex-col justify-center px-5 pt-32 md:px-10">
    <p class="eyebrow">Ошибка 404</p>
    <h1 class="display mt-6 max-w-[16ch] text-[clamp(2.6rem,7vw,6.5rem)]">Такой страницы <em>нет</em></h1>
    <a href={url('/')} class="mt-10 self-start action action-primary">На главную</a>
  </section>
</Base>
