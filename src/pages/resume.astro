---
import Base from '../layouts/Base.astro';
import { facts, person, telegramUrl, url } from '../data/site';

// Источник: резюме hh.ru (май 2025), обновлено на фамилию Молодцова.
// Телефон, дату рождения и адрес не публикуем.
const experience: {
  period: string;
  company: string;
  role: string;
  sections: { text?: string; points?: string[] }[];
}[] = [
  {
    period: 'Апрель 2024 — настоящее время',
    company: 'ПАО «Банк ПСБ»',
    role: 'Продуктовый дизайнер',
    sections: [
      { text: 'Работаю продуктовым дизайнером в команде ЛКПК (личного кабинета потенциального клиента).' },
      {
        text: 'Я разработала:',
        points: [
          'подачу заявки на онлайн открытие расчетного счета для бизнеса;',
          'подачу заявки на регистрацию бизнеса для ИП через мобильное приложение физлиц;',
          'подачу заявки на открытие счёта для ИП через мобильный банк для физических лиц;',
          'прототип для Финополиса по открытию счёта в мессенджере MAX с бизнес-ассистентом Катюша, использовав Claude Code.',
        ],
      },
      { text: 'Занималась поддержанием кабинета администратора по регистрации бизнеса и актуализацией макетов.' },
      { text: 'Была в команде Кредитов СМБ, проектировала дизайн-макеты для интернет-банка «Мой бизнес» и мобильного банка «ПСБ Бизнес».' },
      {
        text: 'Я разработала:',
        points: [
          'подачу заявок и отображение в ДБО новых кредитных продуктов «Бизнес-кредит», «СуперОвердрафт» и электронных банковских гарантий;',
          'загрузку документов в рамках финансового мониторинга в мобильном банке;',
          'адаптивы к сервису подписания КОД, кредитных разделов и заявки на досрочное погашение;',
          'подачу заявки на возобновляемую кредитную линию «Без бумаг | На развитие», её сопровождение, выдачу транша и досрочное погашение.',
        ],
      },
      {
        text: 'Также состою в команде «Паттернов»:',
        points: [
          'унифицирую существующие UX-паттерны в ПСБ и дорабатываю их;',
          'пишу документацию для дизайнеров.',
        ],
      },
      { text: 'Выступаю на дизайн-демо, участвую в демо команд и хакатонах.' },
      { text: 'Участвую в рефакторинге дизайн-системы.' },
      { text: 'Отвечала за написание DoR для передачи компонентов в разработку.' },
    ],
  },
  {
    period: 'Июнь 2023 — апрель 2024',
    company: 'amoCRM',
    role: 'UX/UI Дизайнер',
    sections: [
      { text: 'Основная часть моей работы — это дизайн интерфейсов CRM-системы «amoCRM» или «Kommo» (международное наименование) и amo мессенджер.' },
      {
        text: 'Для основного продукта компании (amoCRM) разработала:',
        points: [
          'интерфейс мобильной страницы Paywall;',
          'новое поле Баннера счета в настройке Paywall, его функционал и его итоговое изображение на странице оплаты;',
          'закрепы сообщений в чатах и ботах для «amo | корпоративный мессенджер» (Desktop, Android, iOS);',
          'темную тему для корпоративного мессенджера.',
        ],
      },
      {
        text: 'Для kommo (международное подразделение) спроектировала:',
        points: [
          'новый функционал CRM-плагина — установка кнопки чата на сайт через Google Tag Manager;',
          'настройку List Messages для белого WhatsApp в шаге бота.',
        ],
      },
      {
        text: 'Также были задачи по графике:',
        points: [
          'делала дизайн Email-рассылок к Новому Году;',
          'картинки для постов и социальных сетей различных ресайзов для запуска рекламной акции;',
          'создание иконок для новых функций;',
          'страницы ошибки оплаты;',
          'отрисовка заглушек, лоадеров для существующих интерфейсов.',
        ],
      },
      { text: 'Принимала участие в создании дизайн системы и собирала UI kit amo' },
    ],
  },
  {
    period: 'Март 2022 — июнь 2023',
    company: 'Центр «Карьера» МИИГАиК',
    role: 'SMM-дизайнер',
    sections: [
      {
        points: [
          'Оформление группы вконтакте Центра «Карьера»;',
          'Создание карточек для постов о новых вакансиях, открытых мероприятиях, ярмарках вакансий и т.д;',
          'Дизайн презентаций для выступления руководства на конференциях;',
          'Создание рекламной печатной продукции, привлекающей студентов и выпускников о новых стажировках и вакансиях;',
          'Анализ статистики группы и настройка рекламы;',
          'Интервьюирование и написание постов о увлечениях студентов и их учебе;',
          'Использование Midjourney и chat-GPT при создании контента.',
        ],
      },
      {
        text: 'Достижения и результаты:',
        points: [
          'Мной была разработана айдентика Центра;',
          'Мной была создана библиотека шаблонов карточек для постов, руководство по стилю Центра;',
          'Увеличила число подписчиков на 34%;',
          'Прокачала насмотренность и навыки коммуникационного дизайна.',
        ],
      },
    ],
  },
];

const education = [
  { year: '2025', title: 'Продукт. Исследования. Метрики', place: 'Formfactor' },
  { year: '2023', title: 'Картография и геоинформатика', place: 'МИИГАиК, высшее' },
  { year: '2023', title: 'Дизайн мобильных приложений', place: 'Skillbox' },
  { year: '2022', title: 'UX-дизайн', place: 'Skillbox' },
  { year: '2021', title: 'Веб-дизайн', place: 'Skillbox' },
];

const skills = [
  'Figma', 'UX-исследования', 'Jobs To Be Done', 'Прототипирование', 'Продуктовые метрики', 'Дизайн-ревью',
  'Адаптивный дизайн', 'Дизайн-системы', 'Анализ целевой аудитории', 'MVP', 'Моушн-дизайн', 'HTML',
];
---

<Base title="Резюме" description="Резюме Марии Молодцовой: продуктовый дизайнер, опыт в банке и CRM.">
  <section class="resume px-5 pt-32 md:px-10 md:pt-44">
    <div class="flex items-center gap-4" data-reveal>
      <img src={url('/assets/about/maria-portrait.webp')} width="64" height="64" alt="" class="shrink-0 rounded-xl" />
      <div>
        <h1 class="display text-2xl md:text-4xl">{person.name}</h1>
        <p class="mt-1 text-muted">{person.role}</p>
      </div>
    </div>

    <dl class="mt-12 grid grid-cols-2 gap-x-6 gap-y-7 border-y border-line py-6 md:mt-16 lg:grid-cols-4" data-reveal>
      {facts.map((fact) => (
        <div>
          <dt class="eyebrow">{fact.label}</dt>
          <dd class="mt-2 text-[15px] leading-snug">{fact.value}</dd>
        </div>
      ))}
    </dl>

    <p class="mt-8 hidden text-sm print:block">{person.email} · t.me/{person.telegram}</p>

    <p class="mt-14 max-w-3xl text-xl leading-relaxed text-fg/85 md:text-2xl" data-reveal>
      Продуктовый дизайнер с&nbsp;опытом в&nbsp;B2B и&nbsp;CRM. Для&nbsp;меня важны не&nbsp;только эстетика, но&nbsp;и&nbsp;осмысленность
      решений. Люблю аккуратность в&nbsp;макетах, чувство вовлечённости в&nbsp;продукт и&nbsp;стремление команды к&nbsp;качественному результату.
    </p>

    <div class="mt-8 flex flex-wrap gap-3 print:hidden" data-reveal>
      <a
        href={url('/assets/maria-molodtsova-resume.pdf')}
        download="Мария Молодцова.pdf"
        class="rounded-full bg-fg px-6 py-3.5 text-sm font-medium text-bg transition-transform hover:scale-[1.04]"
      >
        Скачать в PDF
      </a>
      <a href={telegramUrl} target="_blank" rel="noopener" class="rounded-full border border-line px-6 py-3.5 text-sm hover:border-fg/40">
        Написать в телеграм
      </a>
    </div>

    <h2 class="eyebrow mt-20 border-t border-line pt-6" data-reveal>Опыт работы</h2>
    <div class="divide-y divide-line">
      {
        experience.map((job) => (
          <div class="grid gap-4 py-10 md:grid-cols-[14rem_1fr] md:gap-10" data-reveal>
            <p class="text-sm text-muted">{job.period}</p>
            <div>
              <h3 class="text-2xl font-normal tracking-tight">{job.company}</h3>
              <p class="mt-1 text-muted">{job.role}</p>
              {job.sections.map(({ text, points }) => (
                <Fragment>
                  {text && <p class="mt-4 leading-relaxed text-fg/85">{text}</p>}
                  {points && (
                    <ul class="mt-4 space-y-2 text-[15px] leading-relaxed text-fg/80">
                      {points.map((point) => (
                        <li class="relative pl-5 before:absolute before:left-0 before:top-[0.7em] before:h-px before:w-2.5 before:bg-accent">{point}</li>
                      ))}
                    </ul>
                  )}
                </Fragment>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <div class="grid gap-16 border-t border-line pt-6 md:grid-cols-2">
      <div data-reveal>
        <h2 class="eyebrow">Образование и&nbsp;курсы</h2>
        <ul class="mt-6 space-y-4">
          {
            education.map((e) => (
              <li class="grid grid-cols-[4rem_1fr] gap-4">
                <span class="text-sm tabular-nums text-muted">{e.year}</span>
                <span>
                  {e.title}
                  <span class="block text-sm text-muted">{e.place}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
      <div data-reveal>
        <h2 class="eyebrow">Навыки</h2>
        <ul class="mt-6 flex flex-wrap gap-2">
          {skills.map((s) => <li class="rounded-full border border-line px-3.5 py-1.5 text-sm">{s}</li>)}
        </ul>
        <h2 class="eyebrow mt-10">Языки</h2>
        <p class="mt-4">Русский — родной · Английский — B1</p>
      </div>
    </div>
  </section>
  <div class="h-24"></div>
</Base>

<style is:global>
  @media print {
    @page {
      margin: 14mm;
    }
    html,
    body {
      background: #fff !important;
      color: #111 !important;
    }
    header[data-header],
    footer,
    canvas,
    [data-cursor-el] {
      display: none !important;
    }
    .resume {
      padding: 0 !important;
    }
    .resume * {
      color: #111 !important;
      border-color: #ddd !important;
      opacity: 1 !important;
      transform: none !important;
    }
    .resume .text-muted,
    .resume .eyebrow {
      color: #666 !important;
    }
    .resume h1 {
      font-size: 32pt !important;
    }
    .resume .py-10 {
      padding-block: 12pt !important;
      break-inside: avoid;
    }
    .resume .mt-20,
    .resume .mt-14 {
      margin-top: 16pt !important;
    }
  }
</style>
