---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CaseGrid from '../components/CaseGrid.astro';
import ContactCta from '../components/ContactCta.astro';
import { facts, url } from '../data/site';

const caseOrder = ['online-account', 'katusha-max', 'business-registration', 'credit-line'];
const cases = await getCollection('cases');
const latest = caseOrder.flatMap((id) => cases.filter((item) => item.id === id && item.data.home));

// Строки заголовка появляются по очереди.
const heading = [
  'Проектирую <em class="accent-underline">банковские</em>',
  '<em class="accent-underline">B2B-продукты</em>, в которых',
  'сложное становится понятным',
];
---

<Base>
  <section class="px-5 pt-32 md:px-10 md:pt-[8.75rem]">
    <h1 class="display text-[clamp(2.2rem,4.7vw,4.75rem)]">
      {
        heading.map((line, i) => (
          <span class="block" data-reveal style={`--reveal-delay: ${i * 110}ms`}>
            <Fragment set:html={line} />
          </span>
        ))
      }
    </h1>

    <dl class="mt-12 grid grid-cols-2 gap-x-6 gap-y-7 border-y border-line py-6 md:mt-16 lg:grid-cols-4" data-reveal>
      {facts.map((fact) => (
        <div>
          <dt class="eyebrow">{fact.label}</dt>
          <dd class="mt-2 text-[15px] leading-snug">{fact.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="px-5 pb-10 pt-8 md:px-10 md:pb-16 md:pt-12" aria-label="Кейсы">
    <CaseGrid items={latest} featured fromPath="/" />
    <div class="mt-[60px] flex justify-center" data-reveal>
      <a href={url('/work')} class="rounded-full border border-fg/30 px-7 py-3.5 text-sm transition-colors hover:border-fg">
        Все работы
      </a>
    </div>
  </section>

  <ContactCta compact />
</Base>
