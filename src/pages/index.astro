---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CaseGrid from '../components/CaseGrid.astro';
import ContactCta from '../components/ContactCta.astro';
import { url, telegramUrl, linkedinUrl } from '../data/site';

const caseOrder = ['online-account', 'katusha-max', 'business-registration', 'credit-line'];
const cases = await getCollection('cases');
const latest = caseOrder.flatMap((id) => cases.filter((item) => item.id === id && item.data.home));

// Строки заголовка появляются по очереди.
const heading = [
  'Проектирую <em class="accent-underline">банковские</em>',
  '<em class="accent-underline">B2B-продукты</em>, в которых',
  'сложное становится понятным',
];
---

<Base>
  <section class="@container px-5 pt-32 md:px-10 md:pt-[8.75rem]">
    <h1 class="display text-[min(6.15cqi,4.75rem)]">
      {
        heading.map((line, i) => (
          <span class="block" data-reveal style={`--reveal-delay: ${i * 110}ms`}>
            <Fragment set:html={line} />
          </span>
        ))
      }
    </h1>
    <div class="mt-8 flex flex-wrap gap-2 text-sm font-medium" data-reveal>
      <a href={telegramUrl} target="_blank" rel="noopener" class="action action-primary">Телеграм</a>
      <a href={url('/resume')} class="action action-secondary">Резюме</a>
      <a href={linkedinUrl} target="_blank" rel="noopener" class="action action-secondary">Линкедин</a>
    </div>
  </section>

  <section class="px-5 pb-10 pt-16 md:px-10 md:pb-16 md:pt-28" aria-label="Кейсы">
    <CaseGrid items={latest} featured fromPath="/" />
    <div class="mt-[60px] flex justify-center" data-reveal>
      <a href={url('/work')} class="action action-secondary">
        Все работы
      </a>
    </div>
  </section>

  <ContactCta compact />
</Base>
