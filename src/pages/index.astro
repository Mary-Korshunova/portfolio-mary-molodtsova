---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CaseGrid from '../components/CaseGrid.astro';
import ContactCta from '../components/ContactCta.astro';
import Placeholder from '../components/Placeholder.astro';
import { facts, url } from '../data/site';

const latest = (await getCollection('cases', (c) => c.data.home)).sort((a, b) => a.data.order - b.data.order).slice(0, 4);

// Строки заголовка появляются по очереди.
const heading = [
  'Продуктовый дизайнер из <em>Москвы</em>.',
  'Проектирую B2B-сервисы',
  'для банков и CRM, в которых',
  'сложное становится понятным.',
];
---

<Base>
  <!-- Первый экран: заголовок сверху, факты слева внизу, фото справа (как в референсе) -->
  <section class="relative px-5 pt-32 md:px-10 md:pt-[8.75rem]" style="--photo-w: min(36.5rem, 42vw)">
    <div class="relative flex flex-col md:min-h-[calc(100svh-11.75rem)]">
      <h1 class="display text-[clamp(2.2rem,4.7vw,4.75rem)]">
        {
          heading.map((line, i) => (
            <span class="block" data-reveal style={`--reveal-delay: ${i * 110}ms`}>
              <Fragment set:html={line} />
            </span>
          ))
        }
      </h1>

      <dl
        class="mt-12 grid grid-cols-2 gap-x-6 gap-y-7 md:mt-auto md:max-w-[min(39rem,calc(100%-var(--photo-w)-3rem))] md:pt-12"
        data-reveal
        style="--reveal-delay: 450ms"
      >
        {
          facts.map((f) => (
            <div>
              <dt class="eyebrow">{f.label}</dt>
              <dd class="mt-2 text-[15px] leading-snug">{f.value}</dd>
            </div>
          ))
        }
      </dl>

      <div
        class="relative mt-10 w-full md:absolute md:right-0 md:top-[26rem] md:mt-0 md:w-[var(--photo-w)]"
        data-reveal
        style="--reveal-delay: 300ms"
      >
        <Placeholder caption="Портретное фото Марии на насыщенном фоне, вертикальное" ratio="583 / 640" />
      </div>
    </div>
    <!-- Место под фото, которое выходит за первый экран -->
    <div class="hidden md:block" style="height: max(0px, calc(26rem + var(--photo-w) * 1.098 - 100svh + 11.75rem))"></div>
  </section>

  <section class="px-5 py-20 md:px-10 md:py-32">
    <div class="mb-12 flex items-end justify-between gap-6 md:mb-20">
      <h2 class="display text-4xl md:text-6xl" data-reveal>Последние <em>кейсы</em></h2>
      <a href={url('/work')} class="link-line hidden pb-2 text-sm text-muted hover:text-fg sm:inline" data-reveal>Все работы →</a>
    </div>
    <CaseGrid items={latest} />
    <div class="mt-16 flex justify-center" data-reveal>
      <a href={url('/work')} class="rounded-full border border-fg/30 px-7 py-3.5 text-sm transition-colors hover:border-fg">
        Все работы
      </a>
    </div>
  </section>

  <ContactCta />
</Base>
