---
// Почта — одинаково везде: при наведении подчёркивание и курсор «копировать», по клику копирование и тост «Скопировано».
import { person } from '../data/site';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<button
  type="button"
  class:list={['group block max-w-full break-words text-left', className]}
  data-copy={person.email}
  data-cursor="copy"
  aria-label={`Скопировать почту ${person.email}`}
>
  <span
    class="bg-[linear-gradient(currentColor,currentColor)] bg-[length:0%_0.05em] bg-left-bottom bg-no-repeat pb-[0.06em] transition-[background-size] duration-700 ease-out-soft group-hover:bg-[length:100%_0.05em]"
  >
    {person.email}
  </span>
</button>
