---
import { person, telegramUrl } from '../data/site';
---

<footer class="border-t border-line px-5 py-8 text-sm text-muted md:px-10">
  <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <p>
      {person.name} · Москва, <time data-clock>--:--</time>
    </p>
    <ul class="flex flex-wrap gap-x-6 gap-y-2">
      <li><a class="link-line hover:text-fg" href={`mailto:${person.email}`}>Почта</a></li>
      <li><a class="link-line hover:text-fg" href={telegramUrl} target="_blank" rel="noopener">Telegram</a></li>
      <li><a class="link-line hover:text-fg" href={person.behance} target="_blank" rel="noopener">Behance</a></li>
    </ul>
  </div>
</footer>

<script>
  const el = document.querySelector('[data-clock]');
  const fmt = new Intl.DateTimeFormat('ru-RU', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Moscow' });
  const tick = () => el && (el.textContent = fmt.format(new Date()));
  tick();
  setInterval(tick, 30_000);
</script>
