---
import type { CollectionEntry } from 'astro:content';
import CaseCard from './CaseCard.astro';

interface Props {
  items: CollectionEntry<'cases'>[];
  featured?: boolean;
  fromPath?: string;
}
const { items, featured = false, fromPath = '/work' } = Astro.props;
---

<div
  class:list={[
    'grid',
    featured
      ? 'items-start gap-y-16 md:grid-cols-2 md:gap-x-8 md:gap-y-[clamp(6rem,14vw,16rem)]'
      : 'gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3',
  ]}
  data-grid
>
  {items.map((item) => <CaseCard item={item} ratio={featured ? '8 / 11' : '4 / 5'} fromPath={fromPath} />)}
</div>
