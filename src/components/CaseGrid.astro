---
import type { CollectionEntry } from 'astro:content';
import CaseCard from './CaseCard.astro';

interface Props {
  items: CollectionEntry<'cases'>[];
}
const { items } = Astro.props;
---

<!-- Две колонки в шахматном порядке: каждая вторая карточка опущена на --stagger. -->
<div
  class="grid gap-y-16 md:grid-cols-2 md:gap-x-8 md:gap-y-[clamp(6rem,14vw,16rem)] md:pb-[var(--stagger)]"
  style="--stagger: clamp(8rem, 16vw, 15rem)"
  data-grid
>
  {items.map((item, i) => <CaseCard item={item} even={i % 2 === 1} />)}
</div>
