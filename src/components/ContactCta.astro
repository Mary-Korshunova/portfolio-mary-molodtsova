---
import CopyEmail from './CopyEmail.astro';
import { person, telegramUrl, url } from '../data/site';
---

<section class="px-5 pb-16 pt-24 md:px-10 md:pb-24 md:pt-40">
  <p class="eyebrow" data-reveal>Давайте работать вместе</p>
  <h2 class="display mt-6 max-w-[18ch] text-[clamp(2.2rem,5vw,4.5rem)]" data-reveal>
    Быстрее всего отвечаю в <em>Telegram</em>
  </h2>
  <div class="mt-10 flex flex-wrap gap-3" data-reveal>
    <a
      href={telegramUrl}
      target="_blank"
      rel="noopener"
      class="rounded-full bg-fg px-7 py-4 font-medium text-bg transition-transform duration-300 hover:scale-[1.04]"
    >
      Написать в Telegram
    </a>
    <a href={url('/resume')} class="rounded-full border border-fg/30 px-7 py-4 transition-colors hover:border-fg">
      Смотреть резюме
    </a>
  </div>
  <p class="mt-8 text-sm text-muted" data-reveal>
    или на почту <CopyEmail class="ml-1" />
  </p>
</section>
