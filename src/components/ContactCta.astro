---
import CopyEmail from './CopyEmail.astro';
import { telegramUrl, url } from '../data/site';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<section class:list={['px-5 pb-16 md:px-10 md:pb-24', compact ? 'pt-12 md:pt-20' : 'pt-24 md:pt-40']}>
  <p class="eyebrow" data-reveal>Давайте работать вместе</p>
  <div class="@container" data-reveal>
    <CopyEmail class="display mt-6 whitespace-nowrap text-[min(6cqi,6.5rem)]" />
  </div>
  <div class="mt-10 flex flex-wrap gap-3" data-reveal>
    <a
      href={telegramUrl}
      target="_blank"
      rel="noopener"
      class="action action-primary"
    >
      Телеграм
    </a>
    <a href={url('/resume')} class="action action-secondary">
      Резюме
    </a>
  </div>
</section>
