---
// Фон из мерцающих точек, медленно дрейфующих; при скролле слои смещаются с разной скоростью.
// Оптимизация: холст в 1×, звёзды — копии готового спрайта; без скролла — ~30 кадров/с (мерцание медленное).
---

<canvas class="pointer-events-none fixed inset-0 z-0 h-full w-full" aria-hidden="true" data-starfield></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-starfield]')!;
  const ctx = canvas.getContext('2d')!;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  type Star = { x: number; y: number; r: number; depth: number; phase: number; speed: number; drift: number };
  let stars: Star[] = [];
  let w = 0;
  let h = 0;

  // Одна мягкая точка, нарисованная заранее
  const dot = document.createElement('canvas');
  dot.width = dot.height = 16;
  const dctx = dot.getContext('2d')!;
  const grad = dctx.createRadialGradient(8, 8, 0, 8, 8, 8);
  grad.addColorStop(0, 'rgba(241, 238, 242, 1)');
  grad.addColorStop(0.45, 'rgba(241, 238, 242, 0.6)');
  grad.addColorStop(1, 'rgba(241, 238, 242, 0)');
  dctx.fillStyle = grad;
  dctx.fillRect(0, 0, 16, 16);

  const resize = () => {
    w = document.documentElement.clientWidth;
    h = document.documentElement.clientHeight;
    canvas.width = w;
    canvas.height = h;
    const count = Math.round((w * h) / 7000);
    stars = Array.from({ length: count }, () => {
      const depth = Math.random();
      return {
        x: Math.random() * w,
        y: Math.random() * h,
        r: 1.2 + depth * 2.2,
        depth,
        phase: Math.random() * Math.PI * 2,
        speed: 0.4 + Math.random() * 1.2,
        drift: (Math.random() - 0.5) * 0.06,
      };
    });
  };

  const draw = (t: number) => {
    ctx.clearRect(0, 0, w, h);
    const scroll = window.scrollY;
    for (const s of stars) {
      const tw = reduced ? 0.7 : 0.45 + 0.55 * (0.5 + 0.5 * Math.sin(t * 0.001 * s.speed + s.phase));
      const y = (((s.y - scroll * (0.05 + s.depth * 0.25) - t * 0.004 * s.depth) % h) + h) % h;
      const x = (((s.x + t * s.drift * 0.05) % w) + w) % w;
      ctx.globalAlpha = tw * (0.3 + s.depth * 0.6);
      ctx.drawImage(dot, x - s.r, y - s.r, s.r * 2, s.r * 2);
    }
  };

  let lastDraw = 0;
  let lastScroll = -1;
  const loop = (t: number) => {
    // При прокрутке — каждый кадр (параллакс плавный), иначе ~30 кадров/с
    const scrolled = window.scrollY !== lastScroll;
    if (scrolled || t - lastDraw > 32) {
      draw(t);
      lastDraw = t;
      lastScroll = window.scrollY;
    }
    requestAnimationFrame(loop);
  };

  resize();
  window.addEventListener('resize', () => {
    resize();
    draw(performance.now());
  });
  if (reduced) {
    draw(0);
    window.addEventListener('scroll', () => draw(0), { passive: true });
  } else {
    requestAnimationFrame(loop);
  }
</script>
