---
import type { CollectionEntry } from 'astro:content';
import Placeholder from './Placeholder.astro';
import { url } from '../data/site';

interface Props {
  item: CollectionEntry<'cases'>;
  delay?: number;
}
const { item, delay = 0 } = Astro.props;
const { title, year, excerpt, org, cover, coverImage } = item.data;
---

<a
  href={url(`/work/${item.id}`)}
  class="group block"
  data-reveal
  style={`--reveal-delay: ${delay}ms`}
  data-case
  data-year={item.data.year}
  data-platform={item.data.platforms.join('|')}
  data-org={org}
  data-format={item.data.format}
>
  {
    coverImage ? (
      <div class="overflow-hidden rounded-2xl bg-surface">
        <img
          src={url(coverImage)}
          alt={cover}
          loading="lazy"
          class="aspect-[16/10] w-full object-cover transition-transform duration-700 ease-out-soft group-hover:scale-[1.04]"
        />
      </div>
    ) : (
      <Placeholder caption={cover} zoom />
    )
  }
  <div class="mt-5 flex items-baseline justify-between gap-4">
    <h3 class="text-xl font-normal tracking-tight md:text-2xl">
      {title}
      <span class="ml-1 inline-block text-accent opacity-0 transition-all duration-500 group-hover:translate-x-1 group-hover:opacity-100" aria-hidden="true">→</span>
    </h3>
    <span class="shrink-0 text-sm tabular-nums text-muted">{year}</span>
  </div>
  <p class="mt-2 max-w-xl text-[15px] leading-relaxed text-muted">{excerpt}</p>
  <p class="mt-3 text-xs uppercase tracking-[0.12em] text-muted/70">{org} · {item.data.format}</p>
</a>
