---
import type { CollectionEntry } from 'astro:content';
import Placeholder from './Placeholder.astro';
import { url } from '../data/site';

interface Props {
  item: CollectionEntry<'cases'>;
  /** Карточка во второй колонке — сдвигается вниз (шахматный порядок). */
  even?: boolean;
}
const { item, even = false } = Astro.props;
const { title, year, excerpt, org, cover, coverImage } = item.data;
---

<a
  href={url(`/work/${item.id}`)}
  class:list={['group block md:transition-[translate] md:duration-700 md:ease-out-soft md:[&.is-even]:translate-y-[var(--stagger)]', even && 'is-even']}
  data-reveal
  style={even ? '--reveal-delay: 120ms' : undefined}
  data-case
  data-year={item.data.year}
  data-platform={item.data.platforms.join('|')}
  data-org={org}
  data-format={item.data.format}
>
  <div data-cursor="view">
    {
      coverImage ? (
        <div class="overflow-hidden rounded-2xl bg-surface">
          <img
            src={url(coverImage)}
            alt={cover}
            loading="lazy"
            class="aspect-[8/11] w-full object-cover transition-transform duration-700 ease-out-soft group-hover:scale-[1.04]"
          />
        </div>
      ) : (
        <Placeholder caption={cover} ratio="8 / 11" zoom />
      )
    }
  </div>
  <div class="mt-6 flex items-baseline justify-between gap-4">
    <h3 class="text-xl font-normal tracking-tight md:text-[1.375rem]">{title}</h3>
    <span class="shrink-0 text-sm tabular-nums text-fg/80">{year}</span>
  </div>
  <p class="mt-2 max-w-md text-[15px] leading-relaxed text-muted">{excerpt}</p>
</a>
