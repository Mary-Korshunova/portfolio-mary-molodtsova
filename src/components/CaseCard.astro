---
import type { CollectionEntry } from 'astro:content';
import Placeholder from './Placeholder.astro';
import { caseYearLabel, caseYears } from '../data/cases';
import { url } from '../data/site';

interface Props {
  item: CollectionEntry<'cases'>;
  ratio?: string;
  fromPath?: string;
}
const { item, ratio = '8 / 11', fromPath = '/work' } = Astro.props;
const { title, excerpt, org, cover, coverImage, comingSoon } = item.data;
---

<a
  href={`${url(`/work/${item.id}`)}?from=${encodeURIComponent(fromPath)}`}
  class="group block"
  data-reveal
  data-case
  data-year={caseYears(item.data).join('|')}
  data-platform={item.data.platforms.join('|')}
  data-org={org}
  data-format={item.data.format}
>
  <div data-cursor="view" class="relative motion-safe:transition-transform motion-safe:duration-300 motion-safe:group-hover:scale-[1.012]">
    {
      coverImage ? (
        <img src={url(coverImage)} alt={cover} loading="lazy" class="block h-auto w-full rounded-[4px]" />
      ) : comingSoon ? (
        <div class="grid aspect-video place-items-center rounded-[4px] bg-[#201e24] text-lg">Скоро</div>
      ) : (
        <Placeholder caption={cover} ratio={ratio} />
      )
    }
    {comingSoon && coverImage && (
      <span class="absolute left-3 top-3 rounded-full bg-[#201e24] px-4 py-1.5 text-sm font-semibold text-white">
        Скоро
      </span>
    )}
  </div>
  <h3 class="mt-6 text-xl font-normal tracking-tight md:text-[1.375rem]">
    {title} <span class="whitespace-nowrap text-muted"><span aria-hidden="true">•</span> {caseYearLabel(item.data)}</span>
  </h3>
  <p class="mt-2 max-w-md text-[15px] leading-relaxed text-muted">{excerpt}</p>
</a>
